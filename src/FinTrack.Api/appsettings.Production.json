{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [],
    "CrossSiteCookies": false
  },
  "Storage": {
    "Provider": "Gcs",
    "Gcs": {
      "BucketName": ""
    }
  },
  "MassTransit": {
    "UseMongoOutbox": true
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "FinTrackDb"
  },
  "Jwt": {
    "Issuer": "FinTrack",
    "Audience": "FinTrack",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
